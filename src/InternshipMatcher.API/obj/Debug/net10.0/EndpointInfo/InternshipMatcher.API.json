        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "companyName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "companyDescription": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "companyWebsite": {
            "minLength": 1,
            "type": "string",
            "format": "uri"
          },
          "position": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MatchRequest": {
        "type": "object",
