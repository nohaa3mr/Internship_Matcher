{
  "openapi": "3.0.1",
  "info": {
    "title": "InternshipMatcher API",
    "version": "v1"
  },
  "paths": {
    "/api/AI/match-score": {
      "post": {
        "tags": [
          "AI"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/registration": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterationReqVM"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterationReqVM"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterationReqVM"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterationResponseViewModelResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterationResponseViewModelResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterationResponseViewModelResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/Auth/Login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginRequestViewModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginRequestViewModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginRequestViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserLoginResponseViewModelResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserLoginResponseViewModelResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserLoginResponseViewModelResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/Recruiters/Recruiters": {
      "post": {
        "tags": [
          "InternshipMatcher.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecruiterProfileRequestViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/internships": {
      "post": {
        "tags": [
          "InternshipMatcher.API"
        ],
        "operationId": "AddInternship",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddInternshipRequestViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddInternshipResponseViewModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/Test/ping": {
      "get": {
        "tags": [
          "Test"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Test/ping-auth": {
      "get": {
        "tags": [
          "Test"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
